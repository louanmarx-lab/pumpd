{
  "functions": [
    {
      "source": "functions",
      "codebase": "ripped-release",
      "ignore": [
        "node_modules",
        "tests",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
