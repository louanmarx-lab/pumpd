{
  "expo": {
    "name": "RIPPED",
    "slug": "ripped",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "ripped",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.multiplier.ripped",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.multiplier.ripped",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "userInterfaceStyle": "dark",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RIPPED to access your camera to scan workout QR codes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "updates": {
      "url": "https://u.expo.dev/5d872213-25f7-4a4c-b1b6-753d3c67634d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d872213-25f7-4a4c-b1b6-753d3c67634d"
      }
    },
    "owner": "loubrytsite"
  }
}
