{
  "name": "ripped",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "build:apk": "cross-env EAS_NO_VCS=1 eas build -p android --profile preview",
    "update": "cross-env EAS_NO_VCS=1 eas update --channel preview --auto",
    "update:preview": "cross-env EAS_NO_VCS=1 eas update --branch preview --auto"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "buffer": "^6.0.3",
    "expo": "~57.0.20",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "firebase": "^10.12.0",
    "nativewind": "^2.0.11",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
