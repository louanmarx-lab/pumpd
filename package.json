{
  "name": "ripped",
  "version": "1.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "build:apk": "cross-env EAS_NO_VCS=1 npx --yes eas-cli@27.10.0 build --platform android --profile preview",
    "update": "cross-env EAS_NO_VCS=1 npx --yes eas-cli@27.10.0 update --channel preview --platform android --environment preview",
    "update:preview": "cross-env EAS_NO_VCS=1 npx --yes eas-cli@27.10.0 update --channel preview --platform android --environment preview",
    "test:release": "node --test tests/release.test.cjs && npm --prefix functions test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "buffer": "^6.0.3",
    "expo": "~58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "firebase": "^10.12.0",
    "nativewind": "^2.0.11",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-purchases": "^11.0.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "undici": "^6.29.1",
    "@grpc/grpc-js": "^1.13.6"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
